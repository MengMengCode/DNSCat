# 统一行尾，避免跨平台协作把文件弄坏。
# 默认让 Git 自行判断文本并在仓库内规范化为 LF。
* text=auto

# 以下类型必须是 LF：Windows 上检出成 CRLF 会直接导致运行失败。
#   .sh        —— shebang 后带 \r 会让内核找不到解释器
#   Dockerfile —— RUN 指令尾部的 \r 会被带进 shell 命令
#   .yml/.yaml —— 部分解析器对 \r 敏感
*.sh            text eol=lf
Dockerfile*     text eol=lf
*.yml           text eol=lf
*.yaml          text eol=lf
*.go            text eol=lf
go.mod          text eol=lf
go.sum          text eol=lf

# Windows 批处理必须是 CRLF
*.bat           text eol=crlf
*.cmd           text eol=crlf

# 二进制文件不做行尾转换，也不参与 diff
*.png           binary
*.jpg           binary
*.jpeg          binary
*.gif           binary
*.webp          binary
*.ico           binary
*.woff          binary
*.woff2         binary
*.ttf           binary
*.mmdb          binary
